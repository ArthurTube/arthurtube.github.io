[MASH Script]
Version=7.5

[Characters]
Bonzi=Bonzi.acs
Peedy=Peedy.acs
Max=MaxALERT.acs
Genie=Genie.acs
Merlin=Merlin.acs

[LanguageIDs]
Bonzi=&H409
Peedy=&H409
Max=&H409
Genie=&H409
Merlin=&H409

[Script]
Bonzi.TTSModeID = "{CA141FD0-AC7F-11D1-97A3-006008273001}"
Bonzi.MoveTo 100, 430
Set Req = Bonzi.Show()
WaitFor Req
Peedy.TTSModeID = "{CA141FD0-AC7F-11D1-97A3-006008273001}"
Peedy.MoveTo 320, 430
Set Req = Peedy.Show()
WaitFor Req
Max.TTSModeID = "{CA141FD0-AC7F-11D1-97A3-006008273001}"
Max.MoveTo 540, 430
Set Req = Max.Show()
WaitFor Req
Genie.TTSModeID = "{CA141FD0-AC7F-11D1-97A3-006008273000}"
Genie.MoveTo 760, 430
Set Req = Genie.Show()
WaitFor Req
Merlin.TTSModeID = "{CA141FD0-AC7F-11D1-97A3-006008273002}"
Merlin.MoveTo 980, 430
Set Req = Merlin.Show()
WaitFor Req
Set Req = Genie.Speak("Everybody ready? We have a website to introduce!")
WaitFor Req
Set Req = Bonzi.Speak("Ready. I practiced my welcome face.")
WaitFor Req
Set Req = Peedy.Speak("That looks exactly like your banana face.")
WaitFor Req
Set Req = Max.Speak("Hello! Welcome to Arthur Tube's website!")
WaitFor Req
Set Req = Merlin.Speak("A little corner of the internet for videos, projects, and classic desktop characters.")
WaitFor Req
Set Req = Bonzi.Speak("Including a very handsome purple gorilla.")
WaitFor Req
Set Req = Peedy.Speak("And a green bird who keeps the introduction moving.")
WaitFor Req
Set Req = Genie.Speak("The address is arthur tube dot github dot io.")
WaitFor Req
Set Req = Max.Speak("Arthur Tube. One website, plenty to explore.")
WaitFor Req
Set Req = Merlin.Speak("Start with the video shelf. You can find his first website video there.")
WaitFor Req
Set Req = Peedy.Speak("There are Microsoft Agent videos and CyberBuddy demonstrations, too.")
WaitFor Req
Set Req = Bonzi.Speak("So you can watch us after watching us introduce the place where you can watch us.")
WaitFor Req
Set Req = Genie.Speak("I think you just made a circle.")
WaitFor Req
Set Req = Max.Speak("A video circle. Very efficient.")
WaitFor Req
Set Req = Merlin.Speak("Now, the projects. Arthur Tube created CyberBuddy Classic Proxy.")
WaitFor Req
Set Req = Peedy.Speak("It is an unofficial compatibility project for the original CyberBuddy client.")
WaitFor Req
Set Req = Genie.Speak("The site explains its weather, news, and other online features.")
WaitFor Req
Set Req = Max.Speak("It also explains the shared directory and online presence.")
WaitFor Req
Set Req = Merlin.Speak("CyberBuddy Classic Proxy version 6 point 2 finishes Chat and Native L A N messaging. Send and Receive are working.")
WaitFor Req
Set Req = Max.Speak("Native L A N Patch 12 passed the automated tests, and Arthur confirmed the practical recorded Chat and L A N test.")
WaitFor Req
Set Req = Genie.Speak("Select Private, and use the other client's reachable I P address for the next test.")
WaitFor Req
Set Req = Bonzi.Speak("So sending a message to myself is a good start. But now I need another buddy!")
WaitFor Req
Set Req = Merlin.Speak("Chat and Native L A N are now finished for the version 6 point 2 update.")
WaitFor Req

Set Req = Bonzi.Speak("Then we shall have our conversation right here.")
WaitFor Req
Set Req = Bonzi.Speak("Arthur Tube added Fantasyland to his website!")
WaitFor Req
Set Req = Peedy.Speak("It is also known as YouTube Video Editor Remastered, a revival of the classic editor.")
WaitFor Req
Set Req = Max.Speak("The editor was created by jimmy edits fourteen. Arthur added a page to open it from his website.")
WaitFor Req
Set Req = Genie.Speak("Choose Fantasyland on the homepage to open the editor.")
WaitFor Req
Set Req = Merlin.Speak("If it does not appear inside the page, use the link to open the original editor.")
WaitFor Req

Set Req = Peedy.Speak("There is also the BonziBuddy Customizer, another project by Arthur Tube.")
WaitFor Req
Set Req = Bonzi.Speak("You can edit recognized joke, fact, personality, and song data. I approve of more jokes.")
WaitFor Req
Set Req = Max.Speak("Check the download section for instructions and compatibility details.")
WaitFor Req
Set Req = Genie.Speak("And if you feel like a game, try the memory match page.")
WaitFor Req
Set Req = Bonzi.Speak("I remember that game. Probably.")
WaitFor Req
Set Req = Merlin.Speak("The about section tells you more about Arthur Tube, a creator from Brazil.")
WaitFor Req
Set Req = Peedy.Speak("Bonzi and I are his favorite Microsoft Agent characters.")
WaitFor Req
Set Req = Max.Speak("Excuse me, I am standing right here!")
WaitFor Req
Set Req = Genie.Speak("You are still invited, Max.")
WaitFor Req
Set Req = Bonzi.Speak("Arthur Tube added a CyberBuddy museum to his website!")
WaitFor Req
Set Req = Peedy.Speak("It uses downloaded pages and images from the original CyberBuddy website.")
WaitFor Req
Set Req = Max.Speak("The original CyberBuddy was developed by John M. DeFino. Arthur Tube is working on an unofficial continuation.")
WaitFor Req
Set Req = Genie.Speak("Open Museum and weather on the homepage to find all the new pages.")
WaitFor Req
Set Req = Merlin.Speak("The weather page uses the Classic Proxy layout. Current forecasts and historical archives are kept separate.")
WaitFor Req
Set Req = Peedy.Speak("There is a dated news snapshot, plus jokes and thoughts from the proxy.")
WaitFor Req
Set Req = Max.Speak("Email needs the local proxy running on your computer. The website does not run the email bridge.")
WaitFor Req
Set Req = Bonzi.Speak("And Chat is now finished in CyberBuddy Classic Proxy version 6 point 2. Visit the project pages for the latest status.")
WaitFor Req

Set Req = Merlin.Speak("Explore at your own pace. Thanks for visiting Arthur Tube's website!")
WaitFor Req
Set Req = Bonzi.Speak("Enjoy exploring Arthur Tube's website!")
WaitFor Req
Set Req = Peedy.Speak("And if you try Memory Match, Bonzi might need to borrow your memory.")
WaitFor Req

Set Req = Bonzi.Speak("Arthur Tube also has a Bonzi dot com continuation!")
WaitFor Req
Set Req = Peedy.Speak("You can explore recovered original pages and images from two thousand four.")
WaitFor Req
Set Req = Max.Speak("The download page has the unofficial BonziBUDDY update, the E X E Text Customizer, and the data file Customizer.")
WaitFor Req
Set Req = Genie.Speak("The browser launcher opens the site in your default browser, including Edge, Chrome, or Firefox.")
WaitFor Req
Set Req = Merlin.Speak("That opens a separate browser. The old services and the internal Internet Explorer component have not been replaced.")
WaitFor Req

Set Req = Genie.Speak("There is a new math tool too: the Closest Factor Pair Calculator!")
WaitFor Req
Set Req = Peedy.Speak("Type a positive whole number and it finds the closest factors and lists all the factor pairs.")
WaitFor Req
Set Req = Bonzi.Speak("Try six hundred seventy two. The closest pair is twenty four times twenty eight!")
WaitFor Req
Set Req = Max.Speak("You can open the calculator from the Arthur Tube homepage or use its own calculator page.")
WaitFor Req

Set Req = Bonzi.Speak("And now there is an Aperialblocks Band Builder on Arthur Tube's website!")
WaitFor Req
Set Req = Peedy.Speak("It is made to help the Numberblocks community build Aperialblocks faster, with Bands thirty five through five hundred ten, covering numbers three hundred forty one through five thousand one hundred.")
WaitFor Req
Set Req = Max.Speak("The builder includes the current uploaded colours, prime family patterns, checkerboards, own faces, and block shape tools.")
WaitFor Req
Set Req = Genie.Speak("Aperial is base infinity, or base omega, similar to Argam. Official canon Aperial numbers are by Aperial one zero zero eight zero, while generated builder drafts stay separate. Arthur Tube News is new too, with project updates, Aperial and Numberblocks updates, stocks, weather, and more.")
WaitFor Req
Set Req = Merlin.Speak("You can also subscribe with the Arthur Tube News R S S feed in X M L format.")
WaitFor Req
Set Req = Bonzi.Speak("The homepage What's New section and Project Notebook were updated on October twenty fifth, twenty twenty six.")
WaitFor Req
Set Req = Peedy.Speak("Arthur Tube News has also been upgraded into a multi source R S S reader with current external headlines from Fox News and B B C News.")
WaitFor Req
Set Req = Max.Speak("External headlines link directly to their original publishers, while Arthur Tube updates keep their own R S S feed.")
WaitFor Req
Set Req = Genie.Speak("CyberBuddy News keeps its separate Classic Proxy style news page and automated refresh.")
WaitFor Req

[Commands]
MenuName=MASH Menu
ACO=Advanced Character Options|~|Advanced Character Options

[CommandScript:ACO]
AgentControl.PropertySheet.Visible = True
