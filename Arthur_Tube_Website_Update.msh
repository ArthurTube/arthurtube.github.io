[MASH Script]
Version=7.5

[Characters]
Bonzi=Bonzi.acs
Peedy=Peedy.acs
Max=MaxALERT.acs
Genie=Genie.acs
Merlin=Merlin.acs

[LanguageIDs]
Bonzi=&H409
Peedy=&H409
Max=&H409
Genie=&H409
Merlin=&H409

[Script]
Bonzi.TTSModeID = "{CA141FD0-AC7F-11D1-97A3-006008273001}"
Bonzi.MoveTo 100, 430
Set Req = Bonzi.Show()
WaitFor Req
Peedy.TTSModeID = "{CA141FD0-AC7F-11D1-97A3-006008273001}"
Peedy.MoveTo 320, 430
Set Req = Peedy.Show()
WaitFor Req
Max.TTSModeID = "{CA141FD0-AC7F-11D1-97A3-006008273001}"
Max.MoveTo 540, 430
Set Req = Max.Show()
WaitFor Req
Genie.TTSModeID = "{CA141FD0-AC7F-11D1-97A3-006008273000}"
Genie.MoveTo 760, 430
Set Req = Genie.Show()
WaitFor Req
Merlin.TTSModeID = "{CA141FD0-AC7F-11D1-97A3-006008273002}"
Merlin.MoveTo 980, 430
Set Req = Merlin.Show()
WaitFor Req
Set Req = Bonzi.Play("Wave")
WaitFor Req
Set Req = Bonzi.Speak("Hi! Arthur Tube has updated the BonziBUDDY pages on his website!")
WaitFor Req
Set Req = Peedy.Speak("The homepage now has a link to the Bonzi dot com continuation.")
WaitFor Req
Set Req = Max.Speak("It uses original pages and images recovered from the two thousand four archive.")
WaitFor Req
Set Req = Merlin.Speak("The archived page layouts are still there. Arthur added English download instructions.")
WaitFor Req
Set Req = Genie.Speak("Open Downloads and instructions to find the unofficial update and tools.")
WaitFor Req
Set Req = Bonzi.Speak("There is a download link for my unofficial update package!")
WaitFor Req
Set Req = Max.Speak("The original Bonzi Software credits are retained. Arthur Tube made the unofficial changes.")
WaitFor Req
Set Req = Peedy.Speak("The E X E Text Customizer lets you export text, edit it, validate it, and create a separate executable with a backup.")
WaitFor Req
Set Req = Merlin.Speak("Its capacity fix checks for unused original space. Changing a number in a text comment does not create more space in the program.")
WaitFor Req
Set Req = Genie.Speak("There is a separate customizer for jokes, facts, personality messages, and songs.")
WaitFor Req
Set Req = Bonzi.Speak("And you can open the website in your default browser!")
WaitFor Req
Set Req = Peedy.Speak("That can be Microsoft Edge, Google Chrome, Firefox, or another browser you use.")
WaitFor Req
Set Req = Max.Speak("The browser launcher opens a separate browser. It does not replace the Internet Explorer component inside BonziBUDDY.")
WaitFor Req
Set Req = Merlin.Speak("Some archived files are missing, and copying a page does not bring its old online service back.")
WaitFor Req
Set Req = Genie.Speak("Visit arthur tube dot github dot io, then choose the BonziBUDDY continuation.")
WaitFor Req
Set Req = Bonzi.Speak("Thanks for checking out the update!")
WaitFor Req

[Commands]
MenuName=MASH Menu
ACO=Advanced Character Options|~|Advanced Character Options

[CommandScript:ACO]
AgentControl.PropertySheet.Visible = True
