[MASH Script]
Version=7.5

[Characters]
Bonzi=Bonzi.acs
Peedy=Peedy.acs
Max=MaxALERT.acs
Genie=Genie.acs
Merlin=Merlin.acs

[LanguageIDs]
Bonzi=&H409
Peedy=&H409
Max=&H409
Genie=&H409
Merlin=&H409

[Script]
Bonzi.TTSModeID = "{CA141FD0-AC7F-11D1-97A3-006008273001}"
Bonzi.MoveTo 100, 430
Set Req = Bonzi.Show()
WaitFor Req
Peedy.TTSModeID = "{CA141FD0-AC7F-11D1-97A3-006008273001}"
Peedy.MoveTo 320, 430
Set Req = Peedy.Show()
WaitFor Req
Max.TTSModeID = "{CA141FD0-AC7F-11D1-97A3-006008273001}"
Max.MoveTo 540, 430
Set Req = Max.Show()
WaitFor Req
Genie.TTSModeID = "{CA141FD0-AC7F-11D1-97A3-006008273000}"
Genie.MoveTo 760, 430
Set Req = Genie.Show()
WaitFor Req
Merlin.TTSModeID = "{CA141FD0-AC7F-11D1-97A3-006008273002}"
Merlin.MoveTo 980, 430
Set Req = Merlin.Show()
WaitFor Req
Set Req = Bonzi.Play("Wave")
WaitFor Req
Set Req = Bonzi.Speak("Hi! Arthur Tube has a new CyberBuddy Classic Proxy update!")
WaitFor Req
Set Req = Peedy.Speak("CyberBuddy Classic Proxy version six point two now has finished proxy chat support.")
WaitFor Req
Set Req = Max.Speak("Chat send and receive are working, including the shared U I N directory and online users.")
WaitFor Req
Set Req = Merlin.Speak("U I N lookup, ping, and presence are working too.")
WaitFor Req
Set Req = Genie.Speak("Native L A N communication is working in Patch twelve, and it passed the automated tests and the recorded practical test.")
WaitFor Req
Set Req = Bonzi.Speak("That means CyberBuddy Proxy Chat is finished!")
WaitFor Req
Set Req = Peedy.Speak("Patch thirteen is a separate startup update. It is designed to keep Use Server Based Instant Messaging enabled when CyberBuddy starts and runs its introduction.")
WaitFor Req
Set Req = Max.Speak("The working Patch twelve chat transport is preserved. Patch thirteen does not rebuild the chat system.")
WaitFor Req
Set Req = Merlin.Speak("Existing memory, settings, and U I N data are preserved during the update.")
WaitFor Req
Set Req = Genie.Speak("Arthur Tube also prepared a new N S I S installer and a zip package for CyberBuddy Classic Proxy six point two Patch thirteen.")
WaitFor Req
Set Req = Bonzi.Speak("The What's New page and Project Notebook now show CyberBuddy Proxy Chat as finished.")
WaitFor Req
Set Req = Peedy.Speak("The older six point zero and six point one information remains available as project history.")
WaitFor Req
Set Req = Max.Speak("Patch thirteen still needs its final practical Windows startup check before that startup preference fix is marked confirmed.")
WaitFor Req
Set Req = Merlin.Speak("Visit arthur tube dot github dot io for the CyberBuddy Classic Proxy project and downloads.")
WaitFor Req
Set Req = Genie.Speak("This website update script is named Arthur Tube Website Update dot M S H.")
WaitFor Req
Set Req = Bonzi.Speak("Thanks for following the CyberBuddy Classic Proxy project!")
WaitFor Req

[Commands]
MenuName=MASH Menu
ACO=Advanced Character Options|~|Advanced Character Options

[CommandScript:ACO]
AgentControl.PropertySheet.Visible = True
