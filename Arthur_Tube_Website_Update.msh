[MASH Script]
Version=7.5

[Characters]
Bonzi=Bonzi.acs
Peedy=Peedy.acs
Max=MaxALERT.acs
Genie=Genie.acs
Merlin=Merlin.acs

[LanguageIDs]
Bonzi=&H409
Peedy=&H409
Max=&H409
Genie=&H409
Merlin=&H409

[Script]
Bonzi.TTSModeID = "{CA141FD0-AC7F-11D1-97A3-006008273001}"
Bonzi.MoveTo 100, 430
Set Req = Bonzi.Show()
WaitFor Req
Peedy.TTSModeID = "{CA141FD0-AC7F-11D1-97A3-006008273001}"
Peedy.MoveTo 320, 430
Set Req = Peedy.Show()
WaitFor Req
Max.TTSModeID = "{CA141FD0-AC7F-11D1-97A3-006008273001}"
Max.MoveTo 540, 430
Set Req = Max.Show()
WaitFor Req
Genie.TTSModeID = "{CA141FD0-AC7F-11D1-97A3-006008273000}"
Genie.MoveTo 760, 430
Set Req = Genie.Show()
WaitFor Req
Merlin.TTSModeID = "{CA141FD0-AC7F-11D1-97A3-006008273002}"
Merlin.MoveTo 980, 430
Set Req = Merlin.Show()
WaitFor Req
Set Req = Bonzi.Speak("Hi! Arthur Tube has a new CyberBuddy Classic Proxy update!")
WaitFor Req
Set Req = Peedy.Speak("CyberBuddy Classic Proxy version six point two now has finished proxy chat support.")
WaitFor Req
Set Req = Max.Speak("Chat send and receive are working, including the shared U I N directory and online users.")
WaitFor Req
Set Req = Merlin.Speak("U I N lookup, ping, and presence are working too.")
WaitFor Req
Set Req = Genie.Speak("Native L A N communication is working in Patch twelve, and it passed the automated tests and the recorded practical test.")
WaitFor Req
Set Req = Bonzi.Speak("That means CyberBuddy Proxy Chat is finished!")
WaitFor Req
Set Req = Peedy.Speak("Patch thirteen is a separate startup update. It is designed to keep Use Server Based Instant Messaging enabled when CyberBuddy starts and runs its introduction.")
WaitFor Req
Set Req = Max.Speak("The working Patch twelve chat transport is preserved. Patch thirteen does not rebuild the chat system.")
WaitFor Req
Set Req = Merlin.Speak("Existing memory, settings, and U I N data are preserved during the update.")
WaitFor Req
Set Req = Genie.Speak("Arthur Tube also prepared a new N S I S installer and a zip package for CyberBuddy Classic Proxy six point two Patch thirteen.")
WaitFor Req
Set Req = Bonzi.Speak("The What's New page and Project Notebook now show CyberBuddy Proxy Chat as finished.")
WaitFor Req
Set Req = Peedy.Speak("The older six point zero and six point one information remains available as project history.")
WaitFor Req
Set Req = Max.Speak("Patch thirteen still needs its final practical Windows startup check before that startup preference fix is marked confirmed.")
WaitFor Req
Set Req = Merlin.Speak("Visit arthur tube dot github dot io for the CyberBuddy Classic Proxy project and downloads.")
WaitFor Req
Set Req = Genie.Speak("This website update script is named Arthur Tube Website Update dot M S H.")
WaitFor Req
Set Req = Bonzi.Speak("Thanks for following the CyberBuddy Classic Proxy project!")
WaitFor Req

Set Req = Peedy.Speak("There is also a new Closest Factor Pair Calculator on Arthur Tube's website.")
WaitFor Req
Set Req = Max.Speak("Enter any positive whole number and it finds the closest factor pair and every factor pair.")
WaitFor Req
Set Req = Genie.Speak("For example, six hundred seventy two equals twenty four times twenty eight. Those are the closest factors.")
WaitFor Req
Set Req = Merlin.Speak("The What's New page and Project Notebook have been updated for October seventeenth, twenty twenty six.")
WaitFor Req

Set Req = Bonzi.Speak("Arthur Tube's website has another update for October twenty fifth, twenty twenty six!")
WaitFor Req
Set Req = Peedy.Speak("The Aperialblocks Band Builder is now on the website to help the Numberblocks community make Aperialblocks faster.")
WaitFor Req
Set Req = Max.Speak("The website release covers Bands thirty five through five hundred ten, from three hundred forty one through five thousand one hundred.")
WaitFor Req
Set Req = Genie.Speak("Aperial is base infinity, or base omega, similar to Argam. The builder covers Bands thirty five through five hundred ten, numbers three hundred forty one through five thousand one hundred, and keeps official canon material separate from generated drafts.")
WaitFor Req
Set Req = Merlin.Speak("Supplied complete characters and reference artwork take priority over generated drafts.")
WaitFor Req
Set Req = Bonzi.Speak("Arthur Tube News is also live with a new news page and an R S S feed in X M L format!")
WaitFor Req
Set Req = Peedy.Speak("It is prepared for website and project updates, Aperial and Numberblocks news, stock updates, weather updates, and more.")
WaitFor Req
Set Req = Max.Speak("The homepage What's New section, Project Notebook, navigation, and shortcuts have all been updated.")
WaitFor Req
Set Req = Genie.Speak("The Closest Factor Pair Calculator is still available too. For example, six hundred seventy two equals twenty four times twenty eight.")
WaitFor Req
Set Req = Merlin.Speak("Visit arthur tube dot github dot io, open the Aperialblocks Band Builder, read Arthur Tube News, or subscribe to the R S S feed.")
WaitFor Req

Set Req = Peedy.Speak("Arthur Tube News has also been upgraded into a multi source R S S reader with current external headlines from Fox News and B B C News.")
WaitFor Req
Set Req = Max.Speak("External headlines link directly to their original publishers, while Arthur Tube updates keep their own R S S feed.")
WaitFor Req
Set Req = Genie.Speak("CyberBuddy News keeps its separate Classic Proxy style news page and automated refresh.")
WaitFor Req

[Commands]
MenuName=MASH Menu
ACO=Advanced Character Options|~|Advanced Character Options

[CommandScript:ACO]
AgentControl.PropertySheet.Visible = True
